# Copy this template only when creating a NEW local environment.
# Keep existing .env files when upgrading. Never commit real credentials.
DATABASE_URL="postgresql://alpha_terminal:choose-a-local-password@localhost:5432/alpha_terminal?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side canonical browser-origin override, normally unnecessary locally.
# APP_URL="https://terminal.example.com"
TRUSTED_ORIGINS=""
TRUSTED_CLIENT_IP_HEADER=""

# Registry provider is selected only when instruments are first created.
MARKET_PROVIDER="coinbase"
BINANCE_REST_URL="https://data-api.binance.vision"
TRADING_FEE_RATE="0.001"
QUOTE_MAX_AGE_MS="15000"

# Optional recovery/verification email. Set BOTH values to enable delivery.
# SMTP_URL="smtps://username:password@smtp.example.com:465"
# MAIL_FROM="ALPHA TERMINAL <no-reply@example.com>"

# Optional isolated testing database. Required for non-local test databases.
# TEST_DATABASE_URL="postgresql://alpha_terminal:password@localhost:5432/alpha_terminal_test?schema=public"

# Production startup settings (npm start).
# PORT="3000"
# LISTEN_HOST="0.0.0.0"

# Explicit administrator bootstrap; used only by npm run db:admin.
# ADMIN_EMAIL="operator@example.com"
# ADMIN_PASSWORD="replace-with-a-unique-10-to-72-byte-password"
# ADMIN_USERNAME="operator"
# ADMIN_INITIAL_CAPITAL="10000"
