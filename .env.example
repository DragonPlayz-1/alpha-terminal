DATABASE_URL="postgresql://postgres:password@localhost:5432/alpha_terminal?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_APP_NAME="ALPHA TERMINAL"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional server-side URL when the internal and public URLs differ.
# APP_URL="https://internal.example.com"
TRUSTED_ORIGINS=""
TRUSTED_CLIENT_IP_HEADER=""

# Binance public market-data endpoints. No private trading credentials are used.
BINANCE_REST_URL="https://api.binance.com"
BINANCE_WS_URL="wss://stream.binance.com:9443/stream"

# Optional Redis/Upstash configuration for multi-instance realtime fanout.
REDIS_URL=""
TRADING_FEE_RATE="0.001"
QUOTE_MAX_AGE_MS="15000"

# Optional password recovery/email verification delivery.
SMTP_URL="smtp://username:password@smtp.example.com:587"
MAIL_FROM="ALPHA TERMINAL <no-reply@example.com>"

# One-time administrative bootstrap (used only by npm run db:admin).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
ADMIN_USERNAME="operator"
ADMIN_INITIAL_CAPITAL="10000"
